{
  "name": "queens-bellybutton-video-promo",
  "version": "1.0.0",
  "description": "Vídeo promocional de Queens Bellybutton · Remotion · v5.18",
  "private": true,
  "scripts": {
    "start": "remotion studio",
    "build": "remotion render VideoPromo out/video-promo-landscape.mp4",
    "build:square": "remotion render VideoPromoSquare out/video-promo-square.mp4",
    "build:vertical": "remotion render VideoPromoVertical out/video-promo-vertical.mp4",
    "build:teaser": "remotion render VideoPromoTeaser out/video-promo-teaser-90s.mp4",
    "build:all": "npm run build && npm run build:square && npm run build:vertical && npm run build:teaser",
    "upgrade": "remotion upgrade"
  },
  "dependencies": {
    "@remotion/cli": "4.0.474",
    "@remotion/google-fonts": "4.0.474",
    "@remotion/media-utils": "4.0.474",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "remotion": "4.0.474"
  },
  "devDependencies": {
    "@types/react": "19.0.0",
    "typescript": "5.7.3"
  }
}
